# Email addresses and account identity
EMAIL_ADDRESS=your.account@gmail.com
# Display name used in the From: header
EMAIL_DISPLAY_NAME=AI Agent

# Owner (human) email — the second identity entry in the contact book.
# Required. The contact holding this email is the owner identity and is
# immutable from the tool surface. Identity changes = new setup.
OWNER_EMAIL=your.owner@gmail.com

# Gmail IMAP (receiving)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Gmail SMTP (sending). Default is STARTTLS on 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to true only if you use implicit TLS on port 465.
SMTP_USE_SSL=false

# GPG
GPG_KEY_ID=
# GPG_HOME must be blank (system default) or an ABSOLUTE path.
# Relative paths break the gpg-agent socket on Windows.
GPG_HOME=

# ============================================================================
# Paths — relative values are resolved against the project root, NOT the CWD.
# Windows note: always use forward slashes in path values. Backslashes are
# not reliably handled by python-dotenv.
# ============================================================================
CONTACTS_PATH=data/contacts.json
ARCHIVE_PATH=data/archive.emails.jsonl
LOGS_DIR=logs
PUBKEY_EXPORT_DIR=exported_keys

# ============================================================================
# Secrets — never leave real values here for production. The env backend reads
# the process environment; .env values are loaded into it at startup.
#
# No fallback defaults exist. If any required secret is missing the server
# refuses to start with a clear error listing what is missing.
# ============================================================================
EMAIL_PASSWORD=
GPG_PASSPHRASE=

# Secret resolution backend. M1 supports: env
# M2 roadmap: wincred, keepassxc, pinentry, secretservice
SECRET_BACKEND=env

# ============================================================================
# Passphrase quoting pitfalls (Windows / .env)
# ============================================================================
# Both quoting styles below are valid in .env files; pick one and stay
# consistent. python-dotenv parses single AND double quotes for values
# containing special characters.
#
#   # Style A — double quotes
#   GPG_PASSPHRASE="Pa ss:phr ase; with spaces"
#
#   # Style B — single quotes
#   GPG_PASSPHRASE='Pa ss:phr ase; with spaces'
#
# Issues to avoid:
#   - Do NOT put the passphrase in a "C:/Program Files (x86)/..." path:
#     parentheses inside the value break .env parsing.
#   - A hash `#` at the START of a value line makes python-dotenv treat the
#     whole line as a comment; if your value starts with #, quote it:
#     GPG_PASSPHRASE="#starting-hash"
#   - Backslashes inside quoted values may be eaten by the parser; use
#     forward slashes or escape them.
#   - If a value contains double quotes, use single-quote wrapping and
#     escape with \" inside double quotes, never mix.